# Copie para .env e preencha. O .env é gitignored — nunca versione credencial.
# Este arquivo fica fora do cwd do build, entao a flag e' obrigatoria nos dois casos:
#   CLIENT=basf bun --env-file=clients/basf/.env run core/build.ts
#   docker compose run --rm --env-from-file clients/basf/.env -e CLIENT=basf relatorio

# Azure SQL: <servidor>.database.windows.net
DB_HOST=
# Opcional: porta TCP do SQL Server (padrão 1433).
# DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=Basf-Relatorio

# Deixe VAZIO para Azure (certificado válido, é validado de verdade).
# Só ligue (=true) para instância local/SQL Express com cert self-signed.
# Ligar isso apontando para a Azure desativa a proteção contra MITM.
DB_TRUST_CERT=

# Banco rodando na sua própria máquina e você quer rodar pelo container?
# DB_HOST=host.docker.internal
