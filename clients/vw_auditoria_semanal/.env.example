# Copie para .env e preencha. O .env é gitignored — nunca versione credencial.
# Este arquivo fica fora do cwd do build, entao a flag e' obrigatoria nos dois casos:
#   CLIENT=vw_auditoria bun --env-file=clients/vw_auditoria/.env run core/build.ts
#   docker compose run --rm --env-from-file clients/vw_auditoria/.env -e CLIENT=vw_auditoria relatorio

DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=LogicaChatBot-Prod

# Deixe VAZIO para servidor com certificado válido (é validado de verdade).
# Só ligue (=true) para instância local/SQL Express com cert self-signed.
DB_TRUST_CERT=

# Banco rodando na sua própria máquina e você quer rodar pelo container?
# DB_HOST=host.docker.internal
