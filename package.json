{
  "name": "gerador-relatorios",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "imagem": "bun run scripts/imagem.ts",
    "dash:momentive": "bun build web/momentive/src/preview.ts --outdir web/momentive/dist --target browser --minify",
    "dash:momentive:file": "bun run web/momentive/build-standalone.ts",
    "dash:basf": "bun build web/basf/src/preview.ts --outdir web/basf/dist --target browser --minify",
    "dash:basf:sales": "bun build web/basf/src/preview-sales.ts --outdir web/basf/dist --target browser --minify",
    "dash:basf:serve": "bun run web/basf/servir.ts",
    "dash:basf:snapshot": "uv run --no-project --with pbixray python web/basf/snapshot/extrair_pbix.py && bun --env-file=clients/basf/.env run web/basf/snapshot/vendas.ts && bun run web/basf/snapshot/montar.ts && bun run web/basf/snapshot/conferir.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/d3-array": "^3.2.2",
    "@types/mssql": "^12.3.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "d3-array": "^3.2.4",
    "linkedom": "^0.18.13",
    "mssql": "^12.7.0"
  }
}
